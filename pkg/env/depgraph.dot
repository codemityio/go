digraph DepGraph {
    fontname="Courier New"
    splines="ortho"
    nodesep="1.4"
    ranksep="0.8"
    graph [rankdir="TB", pad="0.2"]
    node [shape="tab", fontname="Courier New", style="filled", fixedsize=false]
    edge [fontname="Courier New", color="grey66", arrowhead="normal", arrowtail="none", arrowsize="0.6", weight="0.5"]
    subgraph deps {
        "github.com/codemityio/go/pkg/env" [label="github.com/codemityio/go/pkg/env", color="gray58", fillcolor="gray99", penwidth=1]
              "github.com/codemityio/go/pkg/env" -> "github.com/sethvargo/go-envconfig"
        "github.com/sethvargo/go-envconfig" [label="github.com/sethvargo/go-envconfig", color="gray65", fillcolor="gray83", penwidth=1]
    }
}

